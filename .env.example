# ============================================
# ColdCenter V1.0 - Environment Configuration
# ============================================

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-realtime-preview
OPENAI_ORGANIZATION_ID=

# ============================================
# ElevenLabs Configuration
# ============================================
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Configuration
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=coldcenter_dev_

# S3 Configuration
S3_BUCKET_NAME=coldcenter-dev
LOCAL_S3_BASE_PATH=./data

# ============================================
# Redis Configuration (for Bull Queue)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Google Calendar Configuration
# ============================================
GOOGLE_CALENDAR_ID=...@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json

# ============================================
# Opel API Configuration
# ============================================
USE_MOCK_OPEL_API=true
OPEL_API_URL=http://localhost:3001
OPEL_API_KEY=
OPEL_API_SECRET=

# ============================================
# VoIP Configuration (Turkcell)
# ============================================
VOIP_PROVIDER=turkcell
VOIP_SIP_URI=
VOIP_USERNAME=
VOIP_PASSWORD=

# ============================================
# Security & Encryption
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT Secret for Dashboard Auth
JWT_SECRET=

# ============================================
# Feature Flags
# ============================================
ENABLE_CALL_RECORDING=true
ENABLE_TRANSCRIPT_STORAGE=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_OUTBOUND_CALLS=true

# ============================================
# Business Hours Configuration
# ============================================
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=1,2,3,4,5,6
TIMEZONE=Europe/Istanbul

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Monitoring & Observability
# ============================================
ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=

# ============================================
# KVKK Compliance
# ============================================
DATA_RETENTION_DAYS=365
PII_MASKING_ENABLED=true
AUDIT_LOG_ENABLED=true
