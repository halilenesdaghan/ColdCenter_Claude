{
  "name": "coldcenter-backend",
  "version": "1.0.0",
  "description": "ColdCenter V1.0 - AI-Powered Call Center Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=__tests__ --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "db:init": "ts-node scripts/init-dynamodb.ts",
    "db:seed": "ts-node scripts/seed-data.ts",
    "db:local": "docker run -d -p 8000:8000 --name dynamodb-local amazon/dynamodb-local",
    "db:stop": "docker stop dynamodb-local && docker rm dynamodb-local",
    "mock-api": "cd mock-api && npm run dev",
    "mock-api:build": "cd mock-api && npm run build",
    "mock-api:start": "cd mock-api && npm start"
  },
  "keywords": [
    "ai",
    "call-center",
    "voip",
    "openai",
    "elevenlabs"
  ],
  "author": "ColdCenter Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.645.0",
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/lib-dynamodb": "^3.645.0",
    "@aws-sdk/client-secrets-manager": "^3.645.0",
    "@aws-sdk/s3-request-presigner": "^3.645.0",
    "express": "^4.19.2",
    "socket.io": "^4.7.2",
    "openai": "^4.58.1",
    "axios": "^1.7.7",
    "ws": "^8.18.0",
    "dotenv": "^16.4.5",
    "winston": "^3.14.2",
    "joi": "^17.13.3",
    "bull": "^4.16.0",
    "ioredis": "^5.4.1",
    "googleapis": "^140.0.1",
    "uuid": "^10.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "compression": "^1.7.4",
    "http-status-codes": "^2.3.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/ws": "^8.5.12",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/bull": "^4.10.0",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^29.5.13",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
